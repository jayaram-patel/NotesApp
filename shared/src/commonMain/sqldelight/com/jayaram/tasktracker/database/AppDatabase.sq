CREATE TABLE Folder (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL
);

CREATE TABLE Note (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    folderId INTEGER NOT NULL,
    text TEXT NOT NULL,
    position INTEGER NOT NULL DEFAULT 0,

    FOREIGN KEY(folderId)
        REFERENCES Folder(id)
        ON DELETE CASCADE
);

--------------------------
-- Folder Queries
--------------------------
getFolders:
SELECT * FROM Folder;

insertFolder:
INSERT INTO Folder(name)
VALUES (?);

deleteFolder:
DELETE FROM Folder
WHERE id=?;

updateFolder:
UPDATE Folder
SET name=?
WHERE id=?;

--------------------------
-- Note Queries
--------------------------

getAllNotes:
SELECT *
FROM Note;

getNotes:
SELECT *
FROM Note
WHERE folderId=?
ORDER BY position ASC;

insertNote:
INSERT INTO Note(folderId, text, position)
VALUES (?, ?, ?);

deleteNote:
DELETE FROM Note
WHERE id=?;

updateNote:
UPDATE Note
SET text=?
WHERE id=?;

updateNotePosition:
UPDATE Note SET position=? WHERE id=?;

getMaxPosition:
SELECT MAX(position) AS maxPos FROM Note WHERE folderId=?;

--------------------------
-- Contact Submission Table
--------------------------

CREATE TABLE ContactSubmission (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    email TEXT NOT NULL,
    message TEXT NOT NULL
);

--------------------------
-- Contact Submission Queries
--------------------------

getAllSubmissions:
SELECT *
FROM ContactSubmission;

insertSubmission:
INSERT INTO ContactSubmission(
    name,
    email,
    message
)
VALUES (?, ?, ?);

deleteSubmission:
DELETE FROM ContactSubmission
WHERE id=?;

deleteAllSubmissions:
DELETE FROM ContactSubmission;

getSubmissionCount:
SELECT COUNT(*)
FROM ContactSubmission;